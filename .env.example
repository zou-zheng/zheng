# 复制为 .env 后填写。不要把真实 Key 写入前端代码或提交到仓库。
PORT=3001
DATA_DIR=./server/data
# 支持 openai 或 deepseek。DeepSeek 拍照识题会自动使用视觉模型。
AI_PROVIDER=deepseek
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
AI_VISION_MODEL=deepseek-v4-flash-vision-exp
# 兼容旧配置：如果没有填写 AI_API_KEY，服务端也会读取 OPENAI_API_KEY。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
AI_PORT=3001
# 后台日志管理员密码；不要提交真实密码，部署平台环境变量中单独填写。
ADMIN_PASSWORD=
# Railway 建议把 Volume 挂载到 /data，并设置 DATA_DIR=/data，避免重部署丢失日志。
DATA_DIR=./server/data
